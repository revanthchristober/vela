# =============================================================================
# VELA — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never
# be committed. Variables prefixed NEXT_PUBLIC_ are inlined into the client
# bundle and are therefore PUBLIC — never put a secret behind that prefix.
# =============================================================================

# -- Public -------------------------------------------------------------------
# Canonical site origin. Used for metadataBase, Open Graph URLs and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Which commerce adapter to use. `mock` reads typed local data and needs no
# credentials; `shopify` requires the Shopify block below. Defaults to `mock`.
NEXT_PUBLIC_COMMERCE_ADAPTER="mock"

# -- Shopify Storefront API (server-only, optional) ---------------------------
# Only required when NEXT_PUBLIC_COMMERCE_ADAPTER=shopify.
# The Storefront API token is scoped and public-safe by Shopify's design, but
# it is kept server-side here so the adapter boundary stays honest.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-01"

# -- Sanity (optional) --------------------------------------------------------
# Only required when editorial content is served from Sanity rather than the
# local content seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_VERSION="2026-01-01"
# Read token — only needed for draft/preview mode. SECRET.
SANITY_API_READ_TOKEN=""

# -- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
